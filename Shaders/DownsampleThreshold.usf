#include "Shared.ush"

float ThresholdLevel;
float ThresholdRange;

float3 Downsample( Texture2D Texture, SamplerState Sampler, float2 UV, float2 PixelSize )
{
	const float2 Coords[13] = {
		float2( -1.0f,  1.0f ), float2(  1.0f,  1.0f ),
		float2( -1.0f, -1.0f ), float2(  1.0f, -1.0f ),

		float2(-2.0f, 2.0f), float2( 0.0f, 2.0f), float2( 2.0f, 2.0f),
		float2(-2.0f, 0.0f), float2( 0.0f, 0.0f), float2( 2.0f, 0.0f),
		float2(-2.0f,-2.0f), float2( 0.0f,-2.0f), float2( 2.0f,-2.0f)
	};


	const float Weights[13] = {
		// 4 samples
		// (1 / 4) * 0.5f = 0.125f
		0.125f, 0.125f,
		0.125f, 0.125f,

		// 9 samples
		// (1 / 9) * 0.5f
		0.0555555f, 0.0555555f, 0.0555555f,
		0.0555555f, 0.0555555f, 0.0555555f,
		0.0555555f, 0.0555555f, 0.0555555f
	};

	float3 OutColor = float3( 0.0f, 0.0f ,0.0f );

	UNROLL
	for( int i = 0; i < 13; i++ )
	{
		float2 CurrentUV = ClampInputUV( UV + Coords[i] * PixelSize );
		OutColor += Weights[i] * Texture2DSample(Texture, Sampler, CurrentUV ).rgb;
	}

	
	// Threshold
	float Luminance = dot(OutColor.rgb, 1);
	float ThresholdScale = saturate( (Luminance - ThresholdLevel) / ThresholdRange );

	return OutColor * ThresholdScale;
}

void DownsamplePS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	out float3 OutColor : SV_Target0 )
{
	float2 InvPixelSize = Input_ExtentInverse * 0.5f;
	float2 UV = InputUV( UVAndScreenPos.xy );
	OutColor.rgb = Downsample( InputTexture, InputSampler, UV, InvPixelSize );
}

SCREEN_PASS_TEXTURE_VIEWPORT(Previous)
Texture2D PreviousTexture;
float Radius;

/** Map a 0..1 pass UV onto the sub-region of PreviousTexture that its viewport uses. */
float2 PreviousUV(float2 UV)
{
	return Previous_UVViewportMin + UV * Previous_UVViewportSize;
}

/** Clamp a previous-texture UV to the bilinear-safe bounds of its viewport. */
float2 ClampPreviousUV(float2 InUV)
{
	return clamp(InUV, Previous_UVViewportBilinearMin, Previous_UVViewportBilinearMax);
}

float3 Upsample( Texture2D Texture, SamplerState Sampler, float2 UV, float2 PixelSize )
{
	const float2 Coords[9] = {
		float2( -1.0f,  1.0f ), float2(  0.0f,  1.0f ), float2(  1.0f,  1.0f ),
		float2( -1.0f,  0.0f ), float2(  0.0f,  0.0f ), float2(  1.0f,  0.0f ),
		float2( -1.0f, -1.0f ), float2(  0.0f, -1.0f ), float2(  1.0f, -1.0f )
	};

	const float Weights[9] = {
		0.0625f, 0.125f, 0.0625f,
		0.125f,  0.25f,  0.125f,
		0.0625f, 0.125f, 0.0625f
	};

	float3 Color = float3( 0.0f, 0.0f, 0.0f );

	UNROLL
	for( int i = 0; i < 9; i++ )
	{
		float2 CurrentUV = ClampPreviousUV( UV + Coords[i] * PixelSize );
		Color += Weights[i] * Texture2DSampleLevel(Texture, Sampler, CurrentUV, 0).rgb;
	}

	return Color;
}

void UpsampleCombinePS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	out float3 OutColor : SV_Target0 )
{
	float2 UV = UVAndScreenPos.xy;

	// Each input has its own viewport, so map the pass UV into each one separately.
	float3 CurrentColor = SampleInput( UV );
	float3 PreviousColor = Upsample( PreviousTexture, InputSampler, PreviousUV(UV), Previous_ExtentInverse );

	OutColor.rgb = lerp(CurrentColor, PreviousColor, Radius);
}